{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "rootDir": "..",
    "outDir": "dist",
    "paths": {
      "@shared": ["../types/index"]
    }
  },
  "include": ["src/**/*.ts", "../types/**/*.ts"]
}
